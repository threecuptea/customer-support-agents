# ─────────────────────────────────────────────────────────────
#  LLM configuration (provider-agnostic via langchain init_chat_model)
# ─────────────────────────────────────────────────────────────
# Pick ANY provider. Leave everything unset to run with the built-in
# zero-config mock model.
#
# Examples:
#   OpenAI:     LLM_MODEL=gpt-4o-mini          + OPENAI_API_KEY
#   Anthropic:  LLM_MODEL=claude-sonnet-4-5    + ANTHROPIC_API_KEY  (LLM_PROVIDER=anthropic)
#   Google:     LLM_MODEL=gemini-2.0-flash     + GOOGLE_API_KEY     (LLM_PROVIDER=google_genai)
#   Ollama:     LLM_MODEL=llama3.1             + (LLM_PROVIDER=ollama)
#   IBM watsonx:LLM_MODEL=meta-llama/llama-3-3-70b-instruct + WATSONX_* (LLM_PROVIDER=ibm)

LLM_MODEL=gpt-4o-mini
# LLM_MODEL=claude-haiku-4-5
# LLM_PROVIDER=anthropic
LLM_TEMPERATURE=0.2

# Uncomment if we found llm test harness result drift for gpt-4o-mini and require a stronger model
# REQUIRE_STRONG_CHAT_NODE_MODEL=true

FASTAPI_SECRET_KEY=
# Provider API keys (set the one matching your model)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# IBM watsonx (only if LLM_PROVIDER=ibm)
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=

# Force the offline mock model regardless of the above
# USE_MOCK_LLM=true

# ─────────────────────────────────────────────────────────────
#  Tools (optional)
# ─────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ─────────────────────────────────────────────────────────────
#  Persistence & server
# ─────────────────────────────────────────────────────────────
# Set a path to enable durable, resumable state across restarts.
# Leave unset for in-memory state.
# PERSISTENCE_PATH=./data
CHECKPOINT_DB=checkpoints.sqlite
STORE_DB=stores.sqlite
PORT=8000
CORS_ORIGINS=*
LOG_LEVEL=INFO
DEMO_MODE=true
# CONNECTION_URL=postgresql://csa:csa@localhost:5432

# CSA for customer-support-agent, CSR for customer-support-representative
CSR_WHITELIST=
CSR_DOMAINS=

AMOUNT_THRESHOLD_AUTO=
DAYS_THRESHOLD_AUTO=

# ─────────────────────────────────────────────────────────────
#  Observability (optional) — LangFuse tracing
# ─────────────────────────────────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENABLED=


# ─────────────────────────────────────────────────────────────
#  Slack integration (optional)
# ─────────────────────────────────────────────────────────────
INTEGRATE_SLACK=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID_REVIEW_DEV=
# Token did not change but webhook has changed every time we re-install the workspace. slack_sdk web client will send messages to the slack hook that SLACK_BOT_TOKEN is associated with. 

REDIS_PASSWORD=
REDIS_URL=
